<%- include('layout/header', { pageTitle: 'Data Mahasiswa & Iuran', pageDesc: 'Kelola data seluruh anggota kelas dan pantau pelunasan kas mingguan' }) %>

<!-- Toolbar Pemilih Minggu Semester -->
<div class="glass-card" style="padding: 16px 22px; margin-bottom: 20px;">
  <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 14px;">
    <div style="display: flex; align-items: center; gap: 12px; flex-wrap: wrap;">
      <label for="selectWeek" style="font-weight: 600; color: #fff; margin: 0;">📅 Pilih Minggu Kuliah:</label>
      <select id="selectWeek" onchange="window.location.href='/members?week=' + this.value" style="width: auto; padding: 7px 14px; font-weight: 600;">
        <% for (let w = 1; w <= 16; w++) { %>
          <option value="<%= w %>" <%= selectedWeek === w ? 'selected' : '' %>>
            Minggu ke-<%= w %> <%= activeWeek === w ? '🌟 (Minggu Aktif)' : '' %>
          </option>
        <% } %>
      </select>

      <% if (selectedWeek !== activeWeek) { %>
        <form action="/members/set-active-week" method="POST" style="display: inline;">
          <input type="hidden" name="active_week" value="<%= selectedWeek %>">
          <button type="submit" class="btn btn-secondary btn-sm" title="Jadikan minggu ini sebagai patokan minggu perkuliahan berjalan">
            ⭐ Set Jadi Minggu Aktif
          </button>
        </form>
      <% } else { %>
        <span class="badge badge-connected">🌟 Minggu Berjalan</span>
      <% } %>
    </div>

    <div>
      <span style="font-size: 0.88rem; color: var(--text-muted);">
        Status Minggu ke-<%= selectedWeek %>: 
        <strong style="color: var(--accent-emerald);"><%= weeklyStatus.totalPaid %> Lunas</strong> • 
        <strong style="color: var(--accent-rose);"><%= weeklyStatus.totalUnpaid %> Belum</strong>
      </span>
    </div>
  </div>
</div>

<div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 16px; margin-bottom: 16px;">
  <div>
    <h2 style="font-size: 1.2rem; font-weight: 700;">Daftar Mahasiswa (Iuran Minggu ke-<%= selectedWeek %>)</h2>
    <p style="font-size: 0.85rem; color: var(--text-muted);">
      Total: <%= weeklyStatus.totalMembers %> mahasiswa aktif
    </p>
  </div>
  <button onclick="openModal('modalAddMember')" class="btn btn-primary">
    ➕ Tambah Mahasiswa
  </button>
</div>

<!-- Tabel Mahasiswa -->
<div class="glass-card">
  <div class="table-responsive">
    <table>
      <thead>
        <tr>
          <th>No</th>
          <th>Nama Mahasiswa</th>
          <th>Nomor WhatsApp</th>
          <th>Status Anggota</th>
          <th>Iuran Minggu Ini</th>
          <th style="text-align: right;">Aksi</th>
        </tr>
      </thead>
      <tbody>
        <% if (members.length === 0) { %>
          <tr>
            <td colspan="6" style="text-align: center; padding: 30px; color: var(--text-dim);">
              Belum ada data mahasiswa. Klik "Tambah Mahasiswa" untuk menambahkan.
            </td>
          </tr>
        <% } %>
        <% members.forEach((m, idx) => { 
             const iuranInfo = weeklyStatus.all.find(w => w.id === m.id);
             const isPaid = iuranInfo && iuranInfo.is_paid === 1;
        %>
          <tr>
            <td><%= idx + 1 %></td>
            <td>
              <strong style="color: #fff;"><%= m.name %></strong>
            </td>
            <td><%= m.phone_number ? m.phone_number : '<span style="color: var(--text-dim);">-</span>' %></td>
            <td>
              <% if (m.is_active) { %>
                <span class="badge badge-connected">Aktif</span>
              <% } else { %>
                <span class="badge badge-disconnected">Nonaktif</span>
              <% } %>
            </td>
            <td>
              <% if (isPaid) { %>
                <span class="badge badge-connected">✅ Lunas (<%= formatter.formatRupiah(iuranInfo.amount) %>)</span>
              <% } else { %>
                <span class="badge badge-disconnected">❌ Belum Bayar</span>
              <% } %>
            </td>
            <td style="text-align: right;">
              <div style="display: inline-flex; gap: 8px;">
                <% if (!isPaid) { %>
                  <button 
                    type="button"
                    data-id="<%= m.id %>" 
                    data-name="<%= m.name %>" 
                    onclick="openQuickPayModal(this)" 
                    class="btn btn-success btn-sm" 
                    title="Tandai Bayar Iuran">
                    💵 Bayar
                  </button>
                <% } %>
                <button 
                  type="button"
                  data-id="<%= m.id %>" 
                  data-name="<%= m.name %>" 
                  data-phone="<%= m.phone_number || '' %>" 
                  data-active="<%= m.is_active ? 1 : 0 %>" 
                  onclick="openEditMemberModal(this)" 
                  class="btn btn-secondary btn-sm" 
                  title="Edit">
                  ✏️
                </button>
                <form action="/members/delete/<%= m.id %>" method="POST" onsubmit="return confirm('Hapus <%= m.name %> dari daftar?');" style="display: inline;">
                  <button type="submit" class="btn btn-danger btn-sm" title="Hapus">
                    🗑️
                  </button>
                </form>
              </div>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</div>

<!-- Modal Tambah Member -->
<div class="modal-overlay" id="modalAddMember">
  <div class="modal-content">
    <div class="card-header">
      <h3 class="card-title">Tambah Mahasiswa Baru</h3>
      <button onclick="closeModal('modalAddMember')" style="background: none; border: none; color: var(--text-muted); cursor: pointer; font-size: 1.2rem;">✕</button>
    </div>
    <form action="/members/add" method="POST">
      <div class="form-group">
        <label for="memberName">Nama Lengkap</label>
        <input type="text" id="memberName" name="name" placeholder="Contoh: Budi Santoso" required>
      </div>
      <div class="form-group">
        <label for="memberPhone">Nomor WhatsApp (Opsional)</label>
        <input type="text" id="memberPhone" name="phone_number" placeholder="Contoh: 081234567890">
      </div>
      <div style="display: flex; justify-content: flex-end; gap: 10px; margin-top: 20px;">
        <button type="button" onclick="closeModal('modalAddMember')" class="btn btn-secondary">Batal</button>
        <button type="submit" class="btn btn-primary">Simpan Mahasiswa</button>
      </div>
    </form>
  </div>
</div>

<!-- Modal Edit Member -->
<div class="modal-overlay" id="modalEditMember">
  <div class="modal-content">
    <div class="card-header">
      <h3 class="card-title">Edit Data Mahasiswa</h3>
      <button onclick="closeModal('modalEditMember')" style="background: none; border: none; color: var(--text-muted); cursor: pointer; font-size: 1.2rem;">✕</button>
    </div>
    <form id="formEditMember" method="POST">
      <div class="form-group">
        <label for="editName">Nama Lengkap</label>
        <input type="text" id="editName" name="name" required>
      </div>
      <div class="form-group">
        <label for="editPhone">Nomor WhatsApp</label>
        <input type="text" id="editPhone" name="phone_number">
      </div>
      <div class="form-group" style="flex-direction: row; align-items: center; gap: 10px;">
        <input type="checkbox" id="editActive" name="is_active" value="1" style="width: auto;">
        <label for="editActive" style="margin: 0; cursor: pointer;">Status Mahasiswa Aktif</label>
      </div>
      <div style="display: flex; justify-content: flex-end; gap: 10px; margin-top: 20px;">
        <button type="button" onclick="closeModal('modalEditMember')" class="btn btn-secondary">Batal</button>
        <button type="submit" class="btn btn-primary">Simpan Perubahan</button>
      </div>
    </form>
  </div>
</div>

<!-- Modal Bayar Iuran Cepat -->
<div class="modal-overlay" id="modalQuickPay">
  <div class="modal-content">
    <div class="card-header">
      <h3 class="card-title">Konfirmasi Bayar Iuran</h3>
      <button onclick="closeModal('modalQuickPay')" style="background: none; border: none; color: var(--text-muted); cursor: pointer; font-size: 1.2rem;">✕</button>
    </div>
    <form action="/members/pay-iuran" method="POST">
      <input type="hidden" id="payMemberId" name="member_id">
      <input type="hidden" name="week_number" value="<%= selectedWeek %>">
      <input type="hidden" name="year" value="<%= selectedYear %>">

      <p style="font-size: 0.95rem; margin-bottom: 16px;">
        Tandai lunas iuran minggu ke-<strong><%= selectedWeek %> (<%= selectedYear %>)</strong> untuk mahasiswa: <br>
        <strong id="payMemberName" style="color: var(--accent-primary); font-size: 1.1rem;"></strong>
      </p>

      <div class="form-group">
        <label for="payAmount">Nominal Iuran (Rp)</label>
        <input type="number" id="payAmount" name="amount" value="10000" required>
      </div>

      <div style="display: flex; justify-content: flex-end; gap: 10px; margin-top: 20px;">
        <button type="button" onclick="closeModal('modalQuickPay')" class="btn btn-secondary">Batal</button>
        <button type="submit" class="btn btn-success">✅ Konfirmasi Pembayaran</button>
      </div>
    </form>
  </div>
</div>

<script>
  function openEditMemberModal(btn) {
    const ds = btn.dataset;
    document.getElementById('formEditMember').action = '/members/edit/' + ds.id;
    document.getElementById('editName').value = ds.name;
    document.getElementById('editPhone').value = ds.phone;
    document.getElementById('editActive').checked = ds.active === '1';
    openModal('modalEditMember');
  }

  function openQuickPayModal(btn) {
    const ds = btn.dataset;
    document.getElementById('payMemberId').value = ds.id;
    document.getElementById('payMemberName').innerText = ds.name;
    openModal('modalQuickPay');
  }
</script>

<%- include('layout/footer') %>
