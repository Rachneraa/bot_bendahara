  </div>
</div>

<!-- Modal Broadcast Jadwal Ujian -->
<div class="modal-overlay" id="modalBroadcastExam">
  <div class="modal-content" style="max-width: 500px;">
    <div class="card-header">
      <h3 class="card-title">📢 Siarkan Jadwal Ujian ke Grup WA</h3>
      <button onclick="closeModal('modalBroadcastExam')" style="background: none; border: none; color: var(--text-muted); cursor: pointer; font-size: 1.2rem;">✕</button>
    </div>
    <form action="/schedules/exams/broadcast" method="POST">
      <div class="form-group">
        <label for="broadcastExamType">Pilih Ujian yang Ingin Disiarkan</label>
        <select id="broadcastExamType" name="exam_type" style="width: 100%; border-radius: var(--radius-sm); padding: 10px; background: rgba(0,0,0,0.3); border: 1px solid var(--border-color); color: #fff;">
          <option value="uts">Ujian Tengah Semester (UTS)</option>
          <option value="uas">Ujian Akhir Semester (UAS)</option>
          <option value="">Seluruh Ujian yang Terdaftar</option>
        </select>
      </div>
      <p style="font-size: 0.85rem; color: var(--text-muted);">
        Pesan broadcast akan mencakup seluruh mata kuliah ujian, tanggal, jam, ruangan, sifat ujian, dan perlengkapan yang wajib dibawa mahasiswa ke grup WhatsApp utama kelas.
      </p>
      <div style="display: flex; justify-content: flex-end; gap: 10px; margin-top: 20px;">
        <button type="button" onclick="closeModal('modalBroadcastExam')" class="btn btn-secondary">Batal</button>
        <button type="submit" class="btn btn-primary" style="background: linear-gradient(135deg, #10b981, #059669); border: none;">
          🚀 Kirim Broadcast Sekarang
        </button>
      </div>
    </form>
  </div>
</div>

<script>
  function updateSweatDates(type) {
    const startInput = document.getElementById('inputSweatStart');
    const endInput = document.getElementById('inputSweatEnd');
    if (type === 'uts') {
      startInput.value = '2026-11-16';
      endInput.value = '2026-11-21';
    } else if (type === 'uas') {
      startInput.value = '2027-01-25';
      endInput.value = '2027-01-30';
    }
  }
</script>

