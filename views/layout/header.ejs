<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof title !== 'undefined' ? title + ' - ' : '' %>Bot Bendahara & Jadwal</title>
  <link rel="stylesheet" href="/css/style.css">
  <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><text y=%22.9em%22 font-size=%2290%22>🤖</text></svg>">
</head>
<body>
  <div class="app-container">
    <!-- Sidebar -->
    <aside class="sidebar">
      <div class="brand">
        <div class="brand-icon">🤖</div>
        <div>
          <h2 class="brand-title">Bot Bendahara</h2>
          <p class="brand-sub">Sekretaris & Pengingat</p>
        </div>
      </div>

      <ul class="nav-links">
        <li class="nav-item <%= currentPath === '/' ? 'active' : '' %>">
          <a href="/">
            <span class="nav-icon">⚡</span>
            <span>Dashboard</span>
          </a>
        </li>
        <li class="nav-item <%= currentPath === '/members' ? 'active' : '' %>">
          <a href="/members">
            <span class="nav-icon">👥</span>
            <span>Data Mahasiswa</span>
          </a>
        </li>
        <li class="nav-item <%= currentPath === '/schedules' ? 'active' : '' %>">
          <a href="/schedules">
            <span class="nav-icon">📚</span>
            <span>Jadwal Kuliah</span>
          </a>
        </li>
        <li class="nav-item <%= currentPath === '/messages' ? 'active' : '' %>">
          <a href="/messages">
            <span class="nav-icon">💬</span>
            <span>Pesan & Siaran</span>
          </a>
        </li>
        <li class="nav-item <%= currentPath === '/kas' ? 'active' : '' %>">
          <a href="/kas">
            <span class="nav-icon">💰</span>
            <span>Buku Kas</span>
          </a>
        </li>
      </ul>

      <div class="user-profile">
        <div class="user-info">
          <div class="user-avatar">
            <%= (user && user.fullName) ? user.fullName.charAt(0).toUpperCase() : 'A' %>
          </div>
          <div class="user-meta">
            <h4><%= (user && user.fullName) ? user.fullName : 'Admin' %></h4>
            <p>@<%= (user && user.username) ? user.username : 'admin' %></p>
          </div>
        </div>
        <a href="/logout" class="btn-logout" title="Keluar">⏻</a>
      </div>
    </aside>

    <!-- Main Wrapper -->
    <div class="main-wrapper">
      <header class="top-bar">
        <div>
          <h1 class="page-title"><%= typeof pageTitle !== 'undefined' ? pageTitle : 'Dashboard' %></h1>
          <p class="page-desc"><%= typeof pageDesc !== 'undefined' ? pageDesc : 'Kelola keuangan kelas dan jadwal otomatis' %></p>
        </div>
      </header>

      <main class="content-body">
