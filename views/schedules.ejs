        <button type="submit" class="btn btn-primary">Simpan Status</button>
      </div>
    </form>
  </div>
</div>

<!-- Modal Atur Minggu Tenang (Sweat Week) -->
<div class="modal-overlay" id="modalSweatWeek">
  <div class="modal-content" style="max-width: 600px;">
    <div class="card-header">
      <h3 class="card-title">⚡ Pengaturan Minggu Tenang (Sweat Week)</h3>
      <button onclick="closeModal('modalSweatWeek')" style="background: none; border: none; color: var(--text-muted); cursor: pointer; font-size: 1.2rem;">✕</button>
    </div>
    <form action="/schedules/sweat-week/set" method="POST">
      <div class="form-group">
        <label for="selectSweatType">Menjelang Ujian</label>
        <select id="selectSweatType" name="exam_type" onchange="updateSweatDates(this.value)" style="width: 100%; border-radius: var(--radius-sm); padding: 10px; background: rgba(0,0,0,0.3); border: 1px solid var(--border-color); color: #fff;">
          <option value="uts" <%= (sweatWeekConfig && sweatWeekConfig.type === 'uts') ? 'selected' : '' %>>Ujian Tengah Semester (UTS) — 16 s.d 21 Nov 2026</option>
          <option value="uas" <%= (sweatWeekConfig && sweatWeekConfig.type === 'uas') ? 'selected' : '' %>>Ujian Akhir Semester (UAS) — 25 s.d 30 Jan 2027</option>
        </select>
      </div>

      <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px;">
        <div class="form-group">
          <label for="inputSweatStart">Tanggal Mulai (Senin)</label>
          <input type="date" id="inputSweatStart" name="start_date" value="<%= (sweatWeekConfig && sweatWeekConfig.startDate) || '2026-11-16' %>" required style="width: 100%; border-radius: var(--radius-sm); padding: 10px; background: rgba(0,0,0,0.3); border: 1px solid var(--border-color); color: #fff;">
        </div>
        <div class="form-group">
          <label for="inputSweatEnd">Tanggal Selesai (Sabtu)</label>
          <input type="date" id="inputSweatEnd" name="end_date" value="<%= (sweatWeekConfig && sweatWeekConfig.endDate) || '2026-11-21' %>" required style="width: 100%; border-radius: var(--radius-sm); padding: 10px; background: rgba(0,0,0,0.3); border: 1px solid var(--border-color); color: #fff;">
        </div>
      </div>

      <div class="form-group" style="margin-top: 10px;">
        <label style="font-weight: 700; color: #fff;">Mata Kuliah yang TETAP MASUK / KULIAH PENGGANTI:</label>
        <p style="font-size: 0.8rem; color: var(--text-muted); margin-bottom: 8px;">
          Centang matkul yang tetap masuk selama minggu tenang. Matkul yang TIDAK dicentang akan otomatis diliburkan dan reminder-nya dimatikan.
        </p>
        <div style="max-height: 180px; overflow-y: auto; background: rgba(0,0,0,0.25); border: 1px solid var(--border-color); border-radius: var(--radius-sm); padding: 10px;">
          <% 
            const existingExceptions = (sweatWeekConfig && sweatWeekConfig.exceptions) || [];
            const uniqueCourses = [...new Set(schedules.map(s => s.course_name))];
          %>
          <% if (uniqueCourses.length === 0) { %>
            <div style="font-size: 0.82rem; color: var(--text-dim); text-align: center; padding: 10px;">Belum ada mata kuliah reguler terdaftar.</div>
          <% } %>
          <% uniqueCourses.forEach(cName => { %>
            <label style="display: flex; align-items: center; gap: 8px; padding: 5px 4px; cursor: pointer; border-bottom: 1px solid rgba(255,255,255,0.05); margin: 0;">
              <input type="checkbox" name="exceptions" value="<%= cName %>" <%= existingExceptions.some(e => e.toLowerCase() === cName.toLowerCase()) ? 'checked' : '' %> style="width: 16px; height: 16px;">
              <span style="font-size: 0.88rem; color: #fff;"><%= cName %></span>
            </label>
          <% }) %>
        </div>
      </div>

      <div class="form-group">
        <label for="inputSweatNote">Catatan Khusus (Opsional)</label>
        <input type="text" id="inputSweatNote" name="exception_notes" value="<%= (sweatWeekConfig && sweatWeekConfig.exceptionNotes) || '' %>" placeholder="Contoh: Manfaatkan waktu minggu tenang untuk belajar maksimal!" style="width: 100%; border-radius: var(--radius-sm); padding: 10px; background: rgba(0,0,0,0.3); border: 1px solid var(--border-color); color: #fff;">
      </div>

      <div class="form-group" style="background: rgba(0,0,0,0.2); padding: 10px 12px; border-radius: 6px; border: 1px solid var(--border-color);">
        <label style="display: flex; align-items: center; gap: 8px; cursor: pointer; margin-bottom: 0;">
          <input type="checkbox" name="broadcast_announcement" checked value="on" style="cursor: pointer; width: 16px; height: 16px;">
          <span style="font-size: 0.85rem; color: #fff;">📢 Kirim siaran pengumuman Minggu Tenang langsung ke Grup WhatsApp</span>
        </label>
      </div>

      <div style="display: flex; justify-content: flex-end; gap: 10px; margin-top: 20px;">
        <button type="button" onclick="closeModal('modalSweatWeek')" class="btn btn-secondary">Batal</button>
        <button type="submit" class="btn btn-primary">Aktifkan Minggu Tenang</button>
      </div>
    </form>
  </div>
</div>

