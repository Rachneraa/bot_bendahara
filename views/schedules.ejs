<%- include('layout/header', { pageTitle: 'Manajemen Jadwal Kuliah', pageDesc: 'Atur jadwal mata kuliah mingguan yang akan otomatis diingatkan H-5 Jam dan H-0' }) %>

<div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 16px;">
  <div>
    <h2 style="font-size: 1.2rem; font-weight: 700;">Daftar Mata Kuliah Mingguan</h2>
    <p style="font-size: 0.85rem; color: var(--text-muted);">
      Sistem cron akan memeriksa jadwal setiap menit dan mengirim pengingat ke grup WhatsApp.
    </p>
  </div>
  <button onclick="openModal('modalAddSchedule')" class="btn btn-primary">
    ➕ Tambah Jadwal Kuliah
  </button>
</div>

<!-- Tabel Jadwal -->
<div class="glass-card">
  <div class="table-responsive">
    <table>
      <thead>
        <tr>
          <th>Hari</th>
          <th>Jam</th>
          <th>Mata Kuliah</th>
          <th>Dosen Pengampu</th>
          <th>Catatan / Lokasi</th>
          <th>Status</th>
          <th style="text-align: right;">Aksi</th>
        </tr>
      </thead>
      <tbody>
        <% if (schedules.length === 0) { %>
          <tr>
            <td colspan="7" style="text-align: center; padding: 36px; color: var(--text-dim);">
              Belum ada jadwal kuliah yang ditambahkan. Silakan klik tombol "Tambah Jadwal Kuliah".
            </td>
          </tr>
        <% } %>
        <% schedules.forEach(s => { %>
          <tr>
            <td>
              <span class="badge" style="background: rgba(99, 102, 241, 0.15); color: #a5b4fc; text-transform: uppercase;">
                <%= s.day_of_week %>
              </span>
            </td>
            <td>
              <strong><%= formatter.formatTime(s.start_time) %> - <%= formatter.formatTime(s.end_time) %></strong>
            </td>
            <td>
              <strong style="color: #fff; font-size: 0.95rem;"><%= s.course_name %></strong>
            </td>
            <td><%= s.lecturer %></td>
            <td>
              <% if (s.note) { %>
                <div><%= s.note %></div>
              <% } else { %>
                <span style="color: var(--text-dim);">-</span>
              <% } %>
              <% if (s.status_override === 'batal') { %>
                <div style="margin-top: 6px; font-size: 0.8rem; background: rgba(239, 68, 68, 0.15); border: 1px solid rgba(239, 68, 68, 0.35); border-radius: 6px; padding: 5px 8px; color: #fca5a5;">
                  <div style="font-weight: 700; display: flex; align-items: center; gap: 4px;">
                    <span>❌</span> KELAS DIBATALKAN / KOSONG:
                  </div>
                  <div style="color: #fff; margin-top: 2px;"><%= s.status_note %></div>
                  <% if (s.override_date) { %>
                    <div style="font-size: 0.72rem; color: #fecaca; margin-top: 3px;">
                      Pertemuan: <%= formatter.formatDateIndo(new Date(s.override_date)) %>
                    </div>
                  <% } %>
                </div>
              <% } else if (s.status_override === 'online') { %>
                <div style="margin-top: 6px; font-size: 0.8rem; background: rgba(59, 130, 246, 0.15); border: 1px solid rgba(59, 130, 246, 0.35); border-radius: 6px; padding: 5px 8px; color: #93c5fd;">
                  <div style="font-weight: 700; display: flex; align-items: center; gap: 4px;">
                    <span>💻</span> KULIAH ONLINE (DARING):
                  </div>
                  <div style="color: #fff; margin-top: 2px; word-break: break-all;"><%= s.status_note %></div>
                  <% if (s.override_date) { %>
                    <div style="font-size: 0.72rem; color: #bfdbfe; margin-top: 3px;">
                      Pertemuan: <%= formatter.formatDateIndo(new Date(s.override_date)) %>
                    </div>
                  <% } %>
                </div>
              <% } else if (s.status_override === 'pindah') { %>
                <div style="margin-top: 6px; font-size: 0.8rem; background: rgba(168, 85, 247, 0.15); border: 1px solid rgba(168, 85, 247, 0.35); border-radius: 6px; padding: 5px 8px; color: #d8b4fe;">
                  <div style="font-weight: 700; display: flex; align-items: center; gap: 4px;">
                    <span>🔄</span> PINDAH KE <%= (s.override_day || '').toUpperCase() %>:
                  </div>
                  <div style="color: #fff; margin-top: 2px;">
                    <%= formatter.formatTime(s.override_start_time) %> - <%= formatter.formatTime(s.override_end_time) %> WIB (<%= s.override_location %>)
                  </div>
                  <% if (s.override_date) { %>
                    <div style="font-size: 0.72rem; color: #e9d5ff; margin-top: 3px;">
                      Tanggal: <%= formatter.formatDateIndo(new Date(s.override_date)) %>
                    </div>
                  <% } %>
                </div>
              <% } %>
              <% if (s.temp_note) { %>
                <div style="margin-top: 6px; font-size: 0.8rem; background: rgba(245, 158, 11, 0.15); border: 1px solid rgba(245, 158, 11, 0.35); border-radius: 6px; padding: 5px 8px; color: #fde047;">
                  <div style="font-weight: 700; display: flex; align-items: center; gap: 4px;">
                    <span>📌</span> Tugas (1x Pakai):
                  </div>
                  <div style="color: #fff; margin-top: 2px;"><%= s.temp_note %></div>
                  <% if (s.temp_note_date) { 
                       const tDate = new Date(s.temp_note_date);
                  %>
                    <div style="font-size: 0.72rem; color: #cbd5e1; margin-top: 3px;">
                      Batas: <%= formatter.formatDateIndo(tDate) %> (<%= formatter.formatTime(s.end_time) %> WIB)
                    </div>
                  <% } %>
                </div>
              <% } %>
            </td>
            <td>
              <form action="/schedules/toggle/<%= s.id %>" method="POST" style="display: inline;">
                <button type="submit" class="badge <%= s.is_active ? 'badge-connected' : 'badge-disconnected' %>" style="cursor: pointer; border: none;">
                  <%= s.is_active ? 'Aktif' : 'Nonaktif' %>
                </button>
              </form>
            </td>
            <td style="text-align: right;">
              <div style="display: inline-flex; gap: 8px;">
                <button 
                  type="button"
                  data-id="<%= s.id %>"
                  data-course="<%= s.course_name %>"
                  data-status="<%= s.status_override || 'normal' %>"
                  data-note="<%= s.status_note || '' %>"
                  data-day="<%= s.override_day || '' %>"
                  data-start="<%= s.override_start_time ? s.override_start_time.slice(0, 5) : '' %>"
                  data-end="<%= s.override_end_time ? s.override_end_time.slice(0, 5) : '' %>"
                  data-loc="<%= s.override_location || '' %>"
                  onclick="openStatusModal(this)"
                  class="btn btn-secondary btn-sm" 
                  style="background: rgba(168, 85, 247, 0.2); border-color: rgba(168, 85, 247, 0.4); color: #c084fc;"
                  title="Atur Status Pertemuan (Batal / Online / Pindah)">
                  🎓 Status 1x
                </button>
                <button 
                  type="button"
                  data-id="<%= s.id %>"
                  data-course="<%= s.course_name %>"
                  data-tempnote="<%= s.temp_note || '' %>"
                  onclick="openTaskModal(this)"
                  class="btn btn-secondary btn-sm" 
                  style="background: rgba(245, 158, 11, 0.2); border-color: rgba(245, 158, 11, 0.4); color: #fbbf24;"
                  title="Atur Catatan Tugas / Bawaan (1x Pakai)">
                  📌 Tugas 1x
                </button>
                <button 
                  type="button"
                  data-id="<%= s.id %>"
                  data-day="<%= s.day_of_week %>"
                  data-start="<%= s.start_time.slice(0, 5) %>"
                  data-end="<%= s.end_time.slice(0, 5) %>"
                  data-course="<%= s.course_name %>"
                  data-lecturer="<%= s.lecturer %>"
                  data-note="<%= s.note || '' %>"
                  data-active="<%= s.is_active ? 1 : 0 %>"
                  onclick="openEditScheduleModal(this)"
                  class="btn btn-secondary btn-sm" 
                  title="Edit">
                  ✏️
                </button>
                <form action="/schedules/delete/<%= s.id %>" method="POST" onsubmit="return confirm('Hapus jadwal matkul <%= s.course_name %>?');" style="display: inline;">
                  <button type="submit" class="btn btn-danger btn-sm" title="Hapus">
                    🗑️
                  </button>
                </form>
              </div>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</div>

<!-- Modal Tambah Jadwal -->
<div class="modal-overlay" id="modalAddSchedule">
  <div class="modal-content">
    <div class="card-header">
      <h3 class="card-title">Tambah Jadwal Kuliah</h3>
      <button onclick="closeModal('modalAddSchedule')" style="background: none; border: none; color: var(--text-muted); cursor: pointer; font-size: 1.2rem;">✕</button>
    </div>
    <form action="/schedules/add" method="POST">
      <div class="form-group">
        <label for="dayOfWeek">Hari Kuliah</label>
        <select id="dayOfWeek" name="day_of_week" required>
          <option value="senin">Senin</option>
          <option value="selasa">Selasa</option>
          <option value="rabu">Rabu</option>
          <option value="kamis">Kamis</option>
          <option value="jumat">Jumat</option>
          <option value="sabtu">Sabtu</option>
          <option value="minggu">Minggu</option>
        </select>
      </div>

      <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 14px;">
        <div class="form-group">
          <label for="startTime">Jam Mulai</label>
          <input type="time" id="startTime" name="start_time" required>
        </div>
        <div class="form-group">
          <label for="endTime">Jam Selesai</label>
          <input type="time" id="endTime" name="end_time" required>
        </div>
      </div>

      <div class="form-group">
        <label for="courseName">Mata Kuliah / Pelajaran</label>
        <input type="text" id="courseName" name="course_name" placeholder="Contoh: Pemrograman Web Lanjut" required>
      </div>

      <div class="form-group">
        <label for="lecturerName">Dosen Pengampu</label>
        <input type="text" id="lecturerName" name="lecturer" placeholder="Contoh: Dr. Ir. Rahmat, M.Kom" required>
      </div>

      <div class="form-group">
        <label for="scheduleNote">Catatan / Ruangan / Tugas (Opsional)</label>
        <input type="text" id="scheduleNote" name="note" placeholder="Contoh: Lab Komputer 3 / Bawa laptop">
      </div>

      <div style="display: flex; justify-content: flex-end; gap: 10px; margin-top: 20px;">
        <button type="button" onclick="closeModal('modalAddSchedule')" class="btn btn-secondary">Batal</button>
        <button type="submit" class="btn btn-primary">Simpan Jadwal</button>
      </div>
    </form>
  </div>
</div>

<!-- Modal Edit Jadwal -->
<div class="modal-overlay" id="modalEditSchedule">
  <div class="modal-content">
    <div class="card-header">
      <h3 class="card-title">Edit Jadwal Kuliah</h3>
      <button onclick="closeModal('modalEditSchedule')" style="background: none; border: none; color: var(--text-muted); cursor: pointer; font-size: 1.2rem;">✕</button>
    </div>
    <form id="formEditSchedule" method="POST">
      <div class="form-group">
        <label for="editDay">Hari Kuliah</label>
        <select id="editDay" name="day_of_week" required>
          <option value="senin">Senin</option>
          <option value="selasa">Selasa</option>
          <option value="rabu">Rabu</option>
          <option value="kamis">Kamis</option>
          <option value="jumat">Jumat</option>
          <option value="sabtu">Sabtu</option>
          <option value="minggu">Minggu</option>
        </select>
      </div>

      <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 14px;">
        <div class="form-group">
          <label for="editStartTime">Jam Mulai</label>
          <input type="time" id="editStartTime" name="start_time" required>
        </div>
        <div class="form-group">
          <label for="editEndTime">Jam Selesai</label>
          <input type="time" id="editEndTime" name="end_time" required>
        </div>
      </div>

      <div class="form-group">
        <label for="editCourse">Mata Kuliah / Pelajaran</label>
        <input type="text" id="editCourse" name="course_name" required>
      </div>

      <div class="form-group">
        <label for="editLecturer">Dosen Pengampu</label>
        <input type="text" id="editLecturer" name="lecturer" required>
      </div>

      <div class="form-group">
        <label for="editNote">Catatan / Ruangan / Tugas</label>
        <input type="text" id="editNote" name="note">
      </div>

      <div class="form-group" style="flex-direction: row; align-items: center; gap: 10px;">
        <input type="checkbox" id="editActive" name="is_active" value="1" style="width: auto;">
        <label for="editActive" style="margin: 0; cursor: pointer;">Jadwal Aktif (Kirim Pengingat Otomatis)</label>
      </div>

      <div style="display: flex; justify-content: flex-end; gap: 10px; margin-top: 20px;">
        <button type="button" onclick="closeModal('modalEditSchedule')" class="btn btn-secondary">Batal</button>
        <button type="submit" class="btn btn-primary">Simpan Perubahan</button>
      </div>
    </form>
  </div>
</div>

<script>
  function openEditScheduleModal(btn) {
    const ds = btn.dataset;
    document.getElementById('formEditSchedule').action = '/schedules/edit/' + ds.id;
    document.getElementById('editDay').value = ds.day;
    document.getElementById('editStartTime').value = ds.start;
    document.getElementById('editEndTime').value = ds.end;
    document.getElementById('editCourse').value = ds.course;
    document.getElementById('editLecturer').value = ds.lecturer;
    document.getElementById('editNote').value = ds.note;
    document.getElementById('editActive').checked = ds.active === '1';
    openModal('modalEditSchedule');
  }

  let currentTaskScheduleId = null;

  function openTaskModal(btn) {
    const ds = btn.dataset;
    currentTaskScheduleId = ds.id;
    document.getElementById('formTaskNote').action = '/schedules/task-note/' + ds.id;
    document.getElementById('taskCourseName').textContent = ds.course;
    document.getElementById('inputTempNote').value = ds.tempnote || '';
    
    const delBtn = document.getElementById('btnDeleteTaskNote');
    if (ds.tempnote && ds.tempnote.trim() !== '') {
      delBtn.style.display = 'inline-block';
    } else {
      delBtn.style.display = 'none';
    }
    openModal('modalTaskNote');
  }

  function clearTaskNote() {
    if (!currentTaskScheduleId) return;
    if (confirm('Hapus catatan tugas 1x pakai untuk matkul ini?')) {
      const f = document.getElementById('formClearTaskNote');
      f.action = '/schedules/task-note/' + currentTaskScheduleId + '/clear';
      f.submit();
    }
  }

  function openStatusModal(btn) {
    const ds = btn.dataset;
    document.getElementById('formClassStatus').action = '/schedules/status/' + ds.id;
    document.getElementById('statusCourseName').textContent = ds.course;

    const currentStatus = ds.status || 'normal';
    document.getElementById('selectStatusType').value = currentStatus;

    document.getElementById('inputStatusReason').value = (currentStatus === 'batal') ? ds.note : '';
    document.getElementById('inputStatusLink').value = (currentStatus === 'online') ? ds.note : '';

    if (currentStatus === 'pindah') {
      document.getElementById('selectNewDay').value = ds.day || 'senin';
      document.getElementById('inputNewStartTime').value = ds.start || '';
      document.getElementById('inputNewEndTime').value = ds.end || '';
      document.getElementById('inputNewLocation').value = ds.loc || '';
    } else {
      document.getElementById('selectNewDay').value = 'senin';
      document.getElementById('inputNewStartTime').value = '';
      document.getElementById('inputNewEndTime').value = '';
      document.getElementById('inputNewLocation').value = '';
    }

    onStatusTypeChange();
    openModal('modalClassStatus');
  }

  function onStatusTypeChange() {
    const val = document.getElementById('selectStatusType').value;
    const secBatal = document.getElementById('sectionBatal');
    const secOnline = document.getElementById('sectionOnline');
    const secPindah = document.getElementById('sectionPindah');

    secBatal.style.display = (val === 'batal') ? 'block' : 'none';
    secOnline.style.display = (val === 'online') ? 'block' : 'none';
    secPindah.style.display = (val === 'pindah') ? 'block' : 'none';

    document.getElementById('inputStatusReason').required = (val === 'batal');
    document.getElementById('inputStatusLink').required = (val === 'online');
    document.getElementById('inputNewStartTime').required = (val === 'pindah');
    document.getElementById('inputNewEndTime').required = (val === 'pindah');
  }
</script>

<!-- Modal Catatan Tugas / Bawaan (1x Pakai) -->
<div class="modal-overlay" id="modalTaskNote">
  <div class="modal-content">
    <div class="card-header">
      <h3 class="card-title">📌 Atur Catatan Tugas / Bawaan (1x Pakai)</h3>
      <button onclick="closeModal('modalTaskNote')" style="background: none; border: none; color: var(--text-muted); cursor: pointer; font-size: 1.2rem;">✕</button>
    </div>
    <form id="formTaskNote" method="POST">
      <div style="margin-bottom: 16px; padding: 12px 14px; background: rgba(99, 102, 241, 0.12); border-left: 3px solid #6366f1; border-radius: 6px; font-size: 0.85rem; color: #c7d2fe;">
        <div>Mata Kuliah: <strong id="taskCourseName" style="color: #fff; font-size: 0.95rem;"></strong></div>
        <div style="font-size: 0.78rem; opacity: 0.85; margin-top: 4px;">
          Catatan ini hanya berlaku 1x untuk pertemuan terdekat dan akan otomatis terhapus saat jam selesai kuliah lewat.
        </div>
      </div>

      <div class="form-group">
        <label for="inputTempNote">Catatan Tugas / Barang Bawaan Khusus</label>
        <textarea id="inputTempNote" name="temp_note" rows="3" placeholder="Contoh: Bawa modul bab 3 & laptop terinstall Node.js" required style="width: 100%; border-radius: var(--radius-sm); padding: 10px; background: rgba(0,0,0,0.3); border: 1px solid var(--border-color); color: #fff;"></textarea>
      </div>

      <div style="display: flex; justify-content: space-between; align-items: center; margin-top: 20px;">
        <button type="button" id="btnDeleteTaskNote" onclick="clearTaskNote()" class="btn btn-danger btn-sm" style="display: none;">
          🗑️ Hapus Catatan
        </button>
        <div style="display: flex; gap: 10px; margin-left: auto;">
          <button type="button" onclick="closeModal('modalTaskNote')" class="btn btn-secondary">Batal</button>
          <button type="submit" class="btn btn-primary">Simpan Catatan</button>
        </div>
      </div>
    </form>
    <form id="formClearTaskNote" method="POST" style="display: none;"></form>
  </div>
</div>

<!-- Modal Status Perkuliahan 1x (Batal / Online / Pindah) -->
<div class="modal-overlay" id="modalClassStatus">
  <div class="modal-content">
    <div class="card-header">
      <h3 class="card-title">🎓 Atur Status Perkuliahan (1x Pakai)</h3>
      <button onclick="closeModal('modalClassStatus')" style="background: none; border: none; color: var(--text-muted); cursor: pointer; font-size: 1.2rem;">✕</button>
    </div>
    <form id="formClassStatus" method="POST">
      <div style="margin-bottom: 16px; padding: 12px 14px; background: rgba(168, 85, 247, 0.12); border-left: 3px solid #a855f7; border-radius: 6px; font-size: 0.85rem; color: #e9d5ff;">
        <div>Mata Kuliah: <strong id="statusCourseName" style="color: #fff; font-size: 0.95rem;"></strong></div>
        <div style="font-size: 0.78rem; opacity: 0.85; margin-top: 4px;">
          Status ini hanya berlaku untuk 1x pertemuan terdekat dan akan otomatis normal kembali setelah perkuliahan selesai.
        </div>
      </div>

      <div class="form-group">
        <label for="selectStatusType">Status Pertemuan</label>
        <select id="selectStatusType" name="status_type" onchange="onStatusTypeChange()" required style="width: 100%; border-radius: var(--radius-sm); padding: 10px; background: rgba(0,0,0,0.3); border: 1px solid var(--border-color); color: #fff;">
          <option value="normal">✅ Normal / Reguler (Sesuai Jadwal)</option>
          <option value="batal">❌ Dibatalkan / Kelas Kosong</option>
          <option value="online">💻 Kuliah Online (Daring / Zoom / GMeet)</option>
          <option value="pindah">🔄 Pindah Jadwal (Kuliah Pengganti)</option>
        </select>
      </div>

      <!-- Field untuk Batal -->
      <div id="sectionBatal" style="display: none;">
        <div class="form-group">
          <label for="inputStatusReason">Alasan Pembatalan / Keterangan</label>
          <input type="text" id="inputStatusReason" name="status_reason" placeholder="Contoh: Dosen berhalangan hadir / sakit" style="width: 100%; border-radius: var(--radius-sm); padding: 10px; background: rgba(0,0,0,0.3); border: 1px solid var(--border-color); color: #fff;">
        </div>
      </div>

      <!-- Field untuk Online -->
      <div id="sectionOnline" style="display: none;">
        <div class="form-group">
          <label for="inputStatusLink">Link / Info Kuliah Online</label>
          <input type="text" id="inputStatusLink" name="status_link" placeholder="Contoh: https://zoom.us/j/... (Password: 123456)" style="width: 100%; border-radius: var(--radius-sm); padding: 10px; background: rgba(0,0,0,0.3); border: 1px solid var(--border-color); color: #fff;">
        </div>
      </div>

      <!-- Field untuk Pindah Jadwal -->
      <div id="sectionPindah" style="display: none;">
        <div class="form-group">
          <label for="selectNewDay">Hari Pengganti</label>
          <select id="selectNewDay" name="new_day" style="width: 100%; border-radius: var(--radius-sm); padding: 10px; background: rgba(0,0,0,0.3); border: 1px solid var(--border-color); color: #fff;">
            <option value="senin">Senin</option>
            <option value="selasa">Selasa</option>
            <option value="rabu">Rabu</option>
            <option value="kamis">Kamis</option>
            <option value="jumat">Jumat</option>
            <option value="sabtu">Sabtu</option>
            <option value="minggu">Minggu</option>
          </select>
        </div>
        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px;">
          <div class="form-group">
            <label for="inputNewStartTime">Jam Mulai Baru</label>
            <input type="time" id="inputNewStartTime" name="new_start_time" style="width: 100%; border-radius: var(--radius-sm); padding: 10px; background: rgba(0,0,0,0.3); border: 1px solid var(--border-color); color: #fff;">
          </div>
          <div class="form-group">
            <label for="inputNewEndTime">Jam Selesai Baru</label>
            <input type="time" id="inputNewEndTime" name="new_end_time" style="width: 100%; border-radius: var(--radius-sm); padding: 10px; background: rgba(0,0,0,0.3); border: 1px solid var(--border-color); color: #fff;">
          </div>
        </div>
        <div class="form-group">
          <label for="inputNewLocation">Ruangan / Lokasi Baru</label>
          <input type="text" id="inputNewLocation" name="new_location" placeholder="Contoh: R5305 (Gedung Miracle) / Online" style="width: 100%; border-radius: var(--radius-sm); padding: 10px; background: rgba(0,0,0,0.3); border: 1px solid var(--border-color); color: #fff;">
        </div>
      </div>

      <div class="form-group" style="margin-top: 14px; background: rgba(0,0,0,0.2); padding: 10px 12px; border-radius: 6px; border: 1px solid var(--border-color);">
        <label style="display: flex; align-items: center; gap: 8px; cursor: pointer; margin-bottom: 0;">
          <input type="checkbox" name="broadcast_announcement" checked value="on" style="cursor: pointer; width: 16px; height: 16px;">
          <span style="font-size: 0.85rem; color: #fff;">📢 Kirim pengumuman langsung ke Grup Kelas WhatsApp</span>
        </label>
      </div>

      <div style="display: flex; justify-content: flex-end; gap: 10px; margin-top: 20px;">
        <button type="button" onclick="closeModal('modalClassStatus')" class="btn btn-secondary">Batal</button>
        <button type="submit" class="btn btn-primary">Simpan Status</button>
      </div>
    </form>
  </div>
</div>

