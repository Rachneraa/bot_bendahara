# ==========================================
# Konfigurasi Lingkungan Docker (docker-compose)
# Salin file ini menjadi .env di server Anda:
# cp .env.docker.example .env
# ==========================================

# Port Server
PORT=3000
PMA_PORT=8080

# Kunci Sesi Dashboard
SESSION_SECRET=acak_string_rahasia_anda_minimal_32_karakter_12345

# Kredensial Database MariaDB Docker
DB_USER=botuser
DB_PASS=botpassword123
DB_NAME=bot_bendahara
DB_ROOT_PASS=rootsecret123

# Kredensial Login Admin Web Dashboard Awal
ADMIN_DEFAULT_USER=admin
ADMIN_DEFAULT_PASS=admin123
ADMIN_DEFAULT_NAME="Bendahara Kelas"

# Nomor WhatsApp Bot untuk Pairing (Format: 628xxxx)
BOT_PHONE_NUMBER=6281234567890

# Daftar Nomor Admin WhatsApp yang Boleh Eksekusi !bot (Pisahkan koma)
ADMIN_NUMBERS=6281234567890,6289876543210

TZ=Asia/Jakarta
