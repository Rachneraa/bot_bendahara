# Konfigurasi Server & Web Dashboard
PORT=3000
NODE_ENV=production
SESSION_SECRET=ganti_dengan_string_acak_rahasia_anda_12345

# Kredensial Database MySQL cPanel / Lokal
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASS=
DB_NAME=bot_bendahara

# Kredensial Default Login Web Dashboard (otomatis dibuat jika tabel users kosong)
ADMIN_DEFAULT_USER=admin
ADMIN_DEFAULT_PASS=admin123
ADMIN_DEFAULT_NAME="Bendahara Kelas"

# Konfigurasi Bot WhatsApp
# Nomor telepon bot untuk pairing code (Format internasional tanpa +, misal: 6281234567890)
BOT_PHONE_NUMBER=6281234567890

# Daftar nomor WhatsApp admin yang boleh memberi perintah !bot (pisahkan dengan koma)
# Format internasional: 628xxxx
ADMIN_NUMBERS=6281234567890,6289876543210

# Zona Waktu
TZ=Asia/Jakarta

# Aktifkan WhatsApp (Set ke false jika hanya ingin dev Web Dashboard di lokal tanpa bentrok dengan bot di server)
ENABLE_WHATSAPP=true

# Mode Bridge API (Jika menjalankan dashboard di laptop lokal tapi ingin menembak Bot WA di server cPanel)
REMOTE_BOT_URL=https://bendahara.riachoune.my.id
BRIDGE_SECRET=bot_bendahara_bridge_2026
